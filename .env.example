# Environment can be `dev`, `staging`, or `prod`.
ENVIRONMENT=dev

# Backend Configuration
BACKEND_ROOT_URI=http://localhost/api

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_ECHO=false

# OAuth2 / OpenID Connect Configuration
ZITADEL_ISSUER=https://id.test-conf.de
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_REDIRECT_URI=http://localhost/auth/callback/zitadel

# OAuth2 Proxy Configuration
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://id.test-conf.de
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=

# Structured Logging
#
# When set, structured log records are appended to this file IN ADDITION to
# stdout.  The just `run` and `backend-run`/`frontend-run` recipes set these
# automatically for development; you normally do not need to set them manually.
#
# LOG_FILE=.logs/backend.jsonl    # set by `just backend-run`
# LOG_FILE=.logs/frontend.jsonl   # set by `just frontend-run`

# Central Observability (staging/production Alloy only)
# Full push endpoint of the central Loki instance on the shared Docker network.
# LOKI_URL=http://loki:3100/loki/api/v1/push

# Exact Docker Compose project label whose containers Alloy should collect.
# ALLOY_DOCKER_COMPOSE_PROJECT=stagingtest-confde
